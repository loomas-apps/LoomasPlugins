{
  "name": "speech-to-text",
  "version": "0.1.0",
  "title": "Speech to text",
  "description": "Writes down what is said in a video or a sound, with the time each sentence starts and ends.",
  "category": "speech",
  "tags": [
    "transcription",
    "subtitles",
    "whisper",
    "language"
  ],
  "home": "home.md",
  "protocol": 2,
  "effect": "pure",
  "command": [
    "python",
    "-m",
    "loomasplugins_speech_to_text"
  ],
  "timeoutSeconds": 3600,
  "concurrency": 1,
  "processes": 1,
  "stallSeconds": 120,
  "permissions": {
    "env": [
      "HF_HOME",
      "HF_HUB_CACHE",
      "HF_HUB_OFFLINE"
    ],
    "network": [
      "huggingface.co"
    ]
  },
  "dependencies": [
    {
      "runtime": "python",
      "minVersion": "3.12",
      "packages": [
        "faster-whisper>=1.1,<2",
        "av>=11,<17"
      ],
      "paths": [
        "src"
      ]
    }
  ],
  "requirements": {
    "cpu": 2,
    "memoryMb": 1500,
    "maxForks": 1
  },
  "actions": {
    "transcribe": {
      "description": "Writes down the sentences said in a video or a sound, with the time each starts and ends. The core may run it a window of the media at a time and join the result: the sentences are joined, text is put together from them and durationMs is the whole media's; language and model are the first window's.",
      "title": "Transcribe speech",
      "icon": "speech",
      "wants": {
        "media": {
          "media": "audio",
          "sampleRate": 16000,
          "channels": 1
        }
      },
      "window": {
        "minMs": 20000,
        "maxMs": 120000,
        "overlapMs": 5000,
        "itemsAt": "sentences",
        "joinText": {
          "field": "text",
          "from": "text",
          "separator": " "
        },
        "durationAt": "durationMs"
      },
      "inputs": {
        "type": "object",
        "properties": {
          "media": {
            "title": "Video or sound",
            "type": [
              "object",
              "string"
            ],
            "description": "The video or sound: an object with an absolute file path (a stored file, or a video as media.open gives it) or a path in text.",
            "x-ui": {
              "group": "everyday"
            }
          },
          "model": {
            "title": "Model",
            "type": "string",
            "maxLength": 200,
            "description": "The speech model: tiny, base, small, medium or large-v3, with .en for English only (default tiny). Downloaded once, on first use.",
            "default": "tiny",
            "x-ui": {
              "group": "everyday",
              "widget": "select",
              "type": "speechModel"
            },
            "enum": [
              "tiny",
              "tiny.en",
              "base",
              "base.en",
              "small",
              "small.en",
              "medium",
              "medium.en",
              "large-v3",
              "large-v3-turbo"
            ]
          },
          "language": {
            "title": "Language spoken",
            "type": "string",
            "description": "The language as a code such as en or pt (default: found out from the first seconds).",
            "x-ui": {
              "group": "everyday",
              "widget": "select",
              "type": "language"
            },
            "enum": [
              "en",
              "zh",
              "de",
              "es",
              "ru",
              "ko",
              "fr",
              "ja",
              "pt",
              "tr",
              "pl",
              "ca",
              "nl",
              "ar",
              "sv",
              "it",
              "id",
              "hi",
              "fi",
              "vi",
              "he",
              "uk",
              "el",
              "ms",
              "cs",
              "ro",
              "da",
              "hu",
              "ta",
              "no",
              "th",
              "ur",
              "hr",
              "bg",
              "lt",
              "la",
              "mi",
              "ml",
              "cy",
              "sk",
              "te",
              "fa",
              "lv",
              "bn",
              "sr",
              "az",
              "sl",
              "kn",
              "et",
              "mk",
              "br",
              "eu",
              "is",
              "hy",
              "ne",
              "mn",
              "bs",
              "kk",
              "sq",
              "sw",
              "gl",
              "mr",
              "pa",
              "si",
              "km",
              "sn",
              "yo",
              "so",
              "af",
              "oc",
              "ka",
              "be",
              "tg",
              "sd",
              "gu",
              "am",
              "yi",
              "lo",
              "uz",
              "fo",
              "ht",
              "ps",
              "tk",
              "nn",
              "mt",
              "sa",
              "lb",
              "my",
              "bo",
              "tl",
              "mg",
              "as",
              "tt",
              "haw",
              "ln",
              "ha",
              "ba",
              "jw",
              "su",
              "yue"
            ]
          },
          "skipSilence": {
            "title": "Skip silence",
            "type": "boolean",
            "description": "Skip the stretches with no speech. It stops the model from inventing words in silence, but it can drop speech that sits over loud music (default false).",
            "default": false,
            "x-ui": {
              "group": "advanced"
            }
          },
          "words": {
            "title": "Give each word its time",
            "type": "boolean",
            "description": "Give each sentence its words, with their own start and end time and confidence (default false).",
            "default": false,
            "x-ui": {
              "group": "advanced"
            }
          },
          "beamSize": {
            "title": "Search width",
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "How many alternatives are weighed: more is slower and a little better (default 5).",
            "default": 5,
            "x-ui": {
              "group": "advanced"
            }
          },
          "device": {
            "title": "Run on",
            "type": "string",
            "enum": [
              "auto",
              "cpu",
              "gpu"
            ],
            "default": "auto",
            "description": "Where the speech model runs: auto takes what Loomas grants (the graphics card when it found a discrete one, else the processor); cpu always uses the processor; gpu asks for the best card. The speech library (CTranslate2) uses NVIDIA cards only, so on an AMD or Intel card the processor is used and the result says why. A card that cannot be used falls back to the processor.",
            "x-ui": {
              "group": "advanced",
              "enumTitles": {
                "auto": "Automatic",
                "cpu": "Processor",
                "gpu": "Graphics card"
              },
              "type": "device"
            }
          }
        },
        "required": [
          "media"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "type": "object",
        "properties": {
          "language": {
            "title": "Language",
            "type": "string"
          },
          "languageProbability": {
            "title": "Language certainty",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "durationMs": {
            "title": "Length of the sound",
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "text": {
            "title": "Sentence",
            "type": "string",
            "description": "Everything said, the sentences joined."
          },
          "sentences": {
            "title": "Sentences",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startMs": {
                  "title": "Start of the sentence",
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "title": "End of the sentence",
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "title": "Sentence",
                  "type": "string"
                },
                "confidence": {
                  "title": "Confidence",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "words": {
                  "title": "Give the words",
                  "type": "array",
                  "description": "Only when words is true: the words of the sentence, in order.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startMs": {
                        "title": "Start of the sentence",
                        "type": "integer",
                        "minimum": 0
                      },
                      "endMs": {
                        "title": "End of the sentence",
                        "type": "integer",
                        "minimum": 0
                      },
                      "text": {
                        "title": "Sentence",
                        "type": "string"
                      },
                      "confidence": {
                        "title": "Confidence",
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "startMs",
                      "endMs",
                      "text",
                      "confidence"
                    ]
                  }
                }
              },
              "required": [
                "startMs",
                "endMs",
                "text",
                "confidence"
              ]
            },
            "x-ui": {
              "type": "transcript"
            }
          },
          "device": {
            "title": "What it ran on",
            "type": [
              "object",
              "null"
            ],
            "description": "What the model really ran on: device (cpu or cuda:N), name (the card, when one was used and its name is known) and fallback (why a card was not used, if it was asked for or granted).",
            "properties": {
              "device": {
                "title": "Device",
                "type": "string",
                "x-ui": {
                  "kind": "text"
                }
              },
              "name": {
                "title": "Graphics card",
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "kind": "text"
                }
              },
              "fallback": {
                "title": "Why not the graphics card",
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "kind": "text"
                }
              }
            }
          }
        },
        "required": [
          "language",
          "durationMs",
          "text",
          "sentences",
          "device"
        ]
      },
      "failures": [
        {
          "code": 400,
          "description": "A param is wrong or media is missing."
        },
        {
          "code": 404,
          "description": "The file is not there."
        },
        {
          "code": 422,
          "description": "No speech could be read from the file (it is damaged or has no audio)."
        },
        {
          "code": 503,
          "description": "The model could not be loaded: usually no network the first time, or a name that is not a model."
        },
        {
          "code": "CANCELLED",
          "description": "The call was cancelled."
        }
      ]
    },
    "detectLanguage": {
      "description": "Says which language is spoken in a video or a sound, from its first seconds, with how sure it is and the next most likely languages. Use it before transcribe when the language is not known, or to sort videos by language.",
      "title": "Detect the language",
      "icon": "audio",
      "wants": {
        "media": {
          "media": "audio",
          "sampleRate": 16000,
          "channels": 1
        }
      },
      "inputs": {
        "type": "object",
        "properties": {
          "media": {
            "title": "Video or sound",
            "type": [
              "object",
              "string"
            ],
            "description": "The video or sound: an object with an absolute file path (a stored file, or a video as media.open gives it) or a path in text.",
            "x-ui": {
              "group": "everyday"
            }
          },
          "model": {
            "title": "Model",
            "type": "string",
            "maxLength": 200,
            "description": "The speech model: tiny, base, small, medium or large-v3, with .en for English only (default tiny). Downloaded once, on first use.",
            "default": "tiny",
            "x-ui": {
              "group": "everyday",
              "widget": "select",
              "type": "speechModel"
            },
            "enum": [
              "tiny",
              "tiny.en",
              "base",
              "base.en",
              "small",
              "small.en",
              "medium",
              "medium.en",
              "large-v3",
              "large-v3-turbo"
            ]
          },
          "device": {
            "title": "Run on",
            "type": "string",
            "enum": [
              "auto",
              "cpu",
              "gpu"
            ],
            "default": "auto",
            "description": "Where the speech model runs: auto takes what Loomas grants (the graphics card when it found a discrete one, else the processor); cpu always uses the processor; gpu asks for the best card. The speech library (CTranslate2) uses NVIDIA cards only, so on an AMD or Intel card the processor is used and the result says why. A card that cannot be used falls back to the processor.",
            "x-ui": {
              "group": "advanced",
              "enumTitles": {
                "auto": "Automatic",
                "cpu": "Processor",
                "gpu": "Graphics card"
              },
              "type": "device"
            }
          }
        },
        "required": [
          "media"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "language": {
            "title": "Language",
            "type": "string",
            "description": "The code of the most likely language, such as en or pt."
          },
          "languageProbability": {
            "title": "Certainty",
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How sure the model is of that language. A sound with no speech gives a low number."
          },
          "candidates": {
            "title": "Most likely languages",
            "type": "array",
            "description": "Up to five languages, the most likely first.",
            "items": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string"
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "device": {
            "title": "What it ran on",
            "type": [
              "object",
              "null"
            ],
            "description": "What the model really ran on: device (cpu or cuda:N), name (the card, when one was used and its name is known) and fallback (why a card was not used, if it was asked for or granted).",
            "properties": {
              "device": {
                "title": "Device",
                "type": "string",
                "x-ui": {
                  "kind": "text"
                }
              },
              "name": {
                "title": "Graphics card",
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "kind": "text"
                }
              },
              "fallback": {
                "title": "Why not the graphics card",
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "kind": "text"
                }
              }
            }
          }
        }
      },
      "failures": [
        {
          "code": 400,
          "description": "A param is wrong or media is missing."
        },
        {
          "code": 404,
          "description": "The file is not there."
        },
        {
          "code": 422,
          "description": "No speech could be read from the file (it is damaged or has no audio)."
        },
        {
          "code": 503,
          "description": "The model could not be loaded: usually no network the first time, or a name that is not a model."
        },
        {
          "code": "CANCELLED",
          "description": "The call was cancelled."
        }
      ]
    }
  }
}
