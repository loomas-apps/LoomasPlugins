{
  "name": "thumbnail",
  "version": "0.1.0",
  "title": "Thumbnails",
  "description": "Chooses the pictures that show a video best.",
  "category": "pictures-files",
  "tags": [
    "thumbnail",
    "contact sheet",
    "pictures"
  ],
  "home": "home.md",
  "protocol": 2,
  "platforms": [
    "windows-x86_64",
    "linux-x86_64",
    "linux-aarch64",
    "macos-aarch64",
    "macos-x86_64"
  ],
  "effect": "pure",
  "command": [
    "../../dist/cargo/release/loomasplugins-thumbnail"
  ],
  "timeoutSeconds": 600,
  "stallSeconds": 60,
  "concurrency": 2,
  "requirements": {
    "cpu": 1,
    "memoryMb": 300
  },
  "actions": {
    "pick": {
      "description": "Chooses the pictures that show a video best: sharp, well exposed, not a black or washed out frame, and not all from the same scene. Gives the times to take them at.",
      "title": "Pick the best pictures",
      "icon": "image",
      "wants": {
        "media": {
          "media": "video",
          "format": "gray8",
          "width": 320,
          "everyMs": 1000
        }
      },
      "inputs": {
        "type": "object",
        "properties": {
          "media": {
            "title": "Video",
            "type": [
              "object",
              "string"
            ],
            "description": "The video: a stored file or a video as media.open gives it, or a path in text. Loomas decodes a grey picture of it every second.",
            "x-ui": {
              "group": "everyday"
            }
          },
          "count": {
            "title": "How many pictures",
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "How many pictures to pick (default 5).",
            "default": 5,
            "x-ui": {
              "group": "everyday"
            }
          },
          "minGapMs": {
            "title": "Least gap between picks",
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000,
            "description": "How far apart two picks must be, in milliseconds (default 2000).",
            "default": 2000,
            "x-ui": {
              "group": "advanced",
              "unit": "ms"
            }
          }
        },
        "required": [
          "media"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "type": "object",
        "properties": {
          "picks": {
            "title": "Picked pictures",
            "type": "array",
            "description": "The best pictures, best first.",
            "items": {
              "type": "object",
              "properties": {
                "timeMs": {
                  "title": "Moment",
                  "type": "integer",
                  "minimum": 0,
                  "description": "When to take the picture, in the time of the video."
                },
                "score": {
                  "title": "Match strength",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sharpness": {
                  "title": "Sharpness",
                  "type": "number",
                  "minimum": 0
                },
                "brightness": {
                  "title": "Brightness",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "timeMs",
                "score",
                "sharpness",
                "brightness"
              ]
            }
          },
          "candidates": {
            "title": "Pictures looked at",
            "type": "integer",
            "minimum": 0,
            "description": "How many pictures were looked at."
          },
          "durationMs": {
            "title": "Length",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "picks",
          "candidates",
          "durationMs"
        ]
      },
      "failures": [
        {
          "code": 400,
          "description": "A param is wrong, or media is missing or not a video Loomas decoded for the plugin."
        },
        {
          "code": 404,
          "description": "A file is not there."
        },
        {
          "code": 422,
          "description": "The video has no picture, or a file cannot be read."
        },
        {
          "code": "CANCELLED",
          "description": "The call was cancelled."
        }
      ]
    },
    "sheet": {
      "description": "Makes one picture that shows a video as a grid of small pictures from along it, spread from the start to the end, and says when each one is from. Use it to see a video at a glance.",
      "title": "Contact sheet",
      "icon": "image",
      "wants": {
        "media": {
          "media": "video",
          "format": "rgb24",
          "width": 240,
          "everyMs": 5000
        }
      },
      "inputs": {
        "type": "object",
        "properties": {
          "media": {
            "title": "Video",
            "type": [
              "object",
              "string"
            ],
            "description": "The video: a stored file or a video as media.open gives it, or a path in text. Loomas decodes a colour picture of it every five seconds.",
            "x-ui": {
              "group": "everyday"
            }
          },
          "columns": {
            "title": "Columns",
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 4,
            "description": "How many pictures in a row (default 4). A video with fewer pictures than this makes one row.",
            "x-ui": {
              "group": "everyday"
            }
          },
          "count": {
            "title": "How many pictures",
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 12,
            "description": "How many pictures on the sheet, spread from the start to the end of the video (default 12). A short video has one picture every five seconds, so it may give fewer.",
            "x-ui": {
              "group": "everyday"
            }
          }
        },
        "required": [
          "media"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "sheet": {
            "title": "Contact sheet",
            "type": "object",
            "description": "The sheet: a stored PNG.",
            "properties": {
              "blob": {
                "title": "Stored file",
                "type": "string"
              },
              "mime": {
                "title": "Type of file",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "bytes": {
                "title": "Size in bytes",
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "blob",
              "mime",
              "path",
              "bytes"
            ]
          },
          "columns": {
            "title": "Columns",
            "type": "integer",
            "minimum": 1
          },
          "rows": {
            "title": "Rows",
            "type": "integer",
            "minimum": 1
          },
          "pictureWidth": {
            "title": "Width of a picture",
            "type": "integer",
            "minimum": 1
          },
          "pictureHeight": {
            "title": "Height of a picture",
            "type": "integer",
            "minimum": 1
          },
          "pictures": {
            "title": "Pictures",
            "type": "array",
            "description": "When each picture is from, in the order they are on the sheet (row by row).",
            "items": {
              "type": "object",
              "properties": {
                "timeMs": {
                  "title": "Moment",
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "timeMs"
              ]
            }
          },
          "durationMs": {
            "title": "Length",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "sheet",
          "columns",
          "rows",
          "pictureWidth",
          "pictureHeight",
          "pictures",
          "durationMs"
        ]
      },
      "failures": [
        {
          "code": 400,
          "description": "A param is wrong, or media is missing or not a video Loomas decoded for the plugin."
        },
        {
          "code": 404,
          "description": "A file is not there."
        },
        {
          "code": 422,
          "description": "The video has no picture, or a file cannot be read."
        },
        {
          "code": "CANCELLED",
          "description": "The call was cancelled."
        }
      ]
    }
  }
}
