{
  "name": "whisper",
  "version": "0.1.0",
  "title": "Speech to text (whisper.cpp)",
  "description": "Writes down what is said in a video or a sound, with the time each sentence starts and ends, using whisper.cpp. It runs on the processor or on a graphics card through Vulkan (AMD, NVIDIA, Intel); its inputs and outputs are those of speech-to-text.",
  "protocol": 2,
  "effect": "pure",
  "platforms": [
    "windows-x86_64",
    "linux-x86_64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "command": [
    "../../dist/cargo/release/loomasplugins-whisper"
  ],
  "timeoutSeconds": 3600,
  "stallSeconds": 120,
  "concurrency": 1,
  "requirements": {
    "cpu": 2,
    "memoryMb": 1500,
    "maxForks": 1
  },
  "permissions": {
    "env": [
      "LOOMAS_MODELS"
    ],
    "network": [
      "huggingface.co",
      "us.aws.cdn.hf.co",
      "cas-bridge.xethub.hf.co"
    ],
    "write": [
      "~/.loomas/models"
    ]
  },
  "actions": {
    "transcribe": {
      "description": "Writes down the sentences said in a video or a sound, with the time each starts and ends. The core may run it a window of the media at a time and join the result: the sentences are joined, text is put together from them and durationMs is the whole media's; language and model are the first window's.",
      "title": "Transcribe speech",
      "category": "find",
      "icon": "speech",
      "inputs": {
        "type": "object",
        "properties": {
          "media": {
            "title": "Video or sound",
            "type": [
              "object",
              "string"
            ],
            "description": "The video or sound: an object with an absolute file path (a stored file, or a video as media.open gives it) or a path in text.",
            "x-ui": {
              "group": "everyday"
            }
          },
          "model": {
            "title": "Model",
            "type": "string",
            "maxLength": 200,
            "description": "The speech model: tiny, base, small, medium, large-v3 or large-v3-turbo, with .en for English only on the first four (default base). Downloaded once, on first use.",
            "default": "base",
            "x-ui": {
              "group": "everyday",
              "widget": "select"
            },
            "enum": [
              "tiny",
              "tiny.en",
              "base",
              "base.en",
              "small",
              "small.en",
              "medium",
              "medium.en",
              "large-v3",
              "large-v3-turbo"
            ]
          },
          "language": {
            "title": "Language spoken",
            "type": "string",
            "description": "The language as a code such as en or pt (default: found out from the first seconds).",
            "x-ui": {
              "group": "everyday",
              "widget": "select"
            }
          },
          "skipSilence": {
            "title": "Skip silence",
            "type": "boolean",
            "description": "Leave out the stretches the model thinks are most likely silence. It stops words invented in silence, but it can drop quiet speech (default false).",
            "default": false,
            "x-ui": {
              "group": "advanced"
            }
          },
          "words": {
            "title": "Give each word its time",
            "type": "boolean",
            "description": "Give each sentence its words, with their own start and end time and confidence (default false).",
            "default": false,
            "x-ui": {
              "group": "advanced"
            }
          },
          "beamSize": {
            "title": "Search width",
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "How many alternatives are weighed: more is slower and a little better (default 5).",
            "default": 5,
            "x-ui": {
              "group": "advanced"
            }
          },
          "device": {
            "title": "Run on",
            "type": "string",
            "default": "auto",
            "description": "Where the speech model runs: auto takes what Loomas grants (else the first graphics card); cpu always uses the processor; gpu or gpu:N asks for a graphics card through Vulkan (AMD, NVIDIA and Intel). A build without Vulkan runs on the processor and says so in device.fallback.",
            "x-ui": {
              "group": "advanced"
            }
          }
        },
        "required": [
          "media"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "type": "object",
        "properties": {
          "language": {
            "title": "Language",
            "type": "string"
          },
          "durationMs": {
            "title": "Length of the sound",
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "text": {
            "title": "Sentence",
            "type": "string",
            "description": "Everything said, the sentences joined."
          },
          "sentences": {
            "title": "Sentences",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startMs": {
                  "title": "Start of the sentence",
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "title": "End of the sentence",
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "title": "Sentence",
                  "type": "string"
                },
                "confidence": {
                  "title": "Confidence",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "words": {
                  "title": "Give the words",
                  "type": "array",
                  "description": "Only when words is true: the words of the sentence, in order.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startMs": {
                        "title": "Start of the sentence",
                        "type": "integer",
                        "minimum": 0
                      },
                      "endMs": {
                        "title": "End of the sentence",
                        "type": "integer",
                        "minimum": 0
                      },
                      "text": {
                        "title": "Sentence",
                        "type": "string"
                      },
                      "confidence": {
                        "title": "Confidence",
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "startMs",
                      "endMs",
                      "text",
                      "confidence"
                    ]
                  }
                }
              },
              "required": [
                "startMs",
                "endMs",
                "text",
                "confidence"
              ]
            },
            "x-ui": {
              "type": "timedText"
            }
          },
          "device": {
            "title": "What it ran on",
            "type": [
              "object",
              "null"
            ],
            "description": "What the model ran on: device (cpu or vulkan:N), name (null: not known) and fallback (why a card was not used, if one was asked for or granted).",
            "properties": {
              "device": {
                "title": "Device",
                "type": "string",
                "x-ui": {
                  "kind": "text"
                }
              },
              "name": {
                "title": "Graphics card",
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "kind": "text"
                }
              },
              "fallback": {
                "title": "Why not the graphics card",
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "kind": "text"
                }
              }
            }
          }
        },
        "required": [
          "language",
          "durationMs",
          "text",
          "sentences",
          "device"
        ]
      },
      "wants": {
        "media": {
          "media": "audio",
          "sampleRate": 16000,
          "channels": 1
        }
      },
      "window": {
        "minMs": 20000,
        "maxMs": 120000,
        "overlapMs": 5000,
        "itemsAt": "sentences",
        "joinText": {
          "field": "text",
          "from": "text",
          "separator": " "
        },
        "durationAt": "durationMs"
      },
      "failures": [
        {
          "code": 400,
          "description": "A param is wrong, or media is not sound Loomas decoded at 16 kHz."
        },
        {
          "code": 422,
          "description": "The model cannot be downloaded or kept (no network, no room)."
        },
        {
          "code": 500,
          "description": "whisper.cpp could not load the model or failed while it listened."
        },
        {
          "code": "CANCELLED",
          "description": "The call was cancelled."
        }
      ]
    }
  }
}
