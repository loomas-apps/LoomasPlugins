{
  "name": "narrate_video",
  "triggers": {
    "call": {
      "type": "Call",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "media": {
              "title": "Video or sound",
              "type": "string",
              "description": "The file to narrate: a video, or a sound with people talking."
            },
            "model": {
              "title": "Speech model",
              "type": "string",
              "default": "base.en",
              "description": "The speech-to-text model (base.en, small, medium...).",
              "x-ui": {
                "type": "speechModel"
              },
              "enum": [
                "tiny",
                "tiny.en",
                "base",
                "base.en",
                "small",
                "small.en",
                "medium",
                "medium.en",
                "large-v3",
                "large-v3-turbo"
              ]
            },
            "language": {
              "title": "Language",
              "type": "string",
              "default": "en",
              "description": "The language people speak, as a code (en, pt...).",
              "x-ui": {
                "type": "language"
              },
              "enum": [
                "en",
                "zh",
                "de",
                "es",
                "ru",
                "ko",
                "fr",
                "ja",
                "pt",
                "tr",
                "pl",
                "ca",
                "nl",
                "ar",
                "sv",
                "it",
                "id",
                "hi",
                "fi",
                "vi",
                "he",
                "uk",
                "el",
                "ms",
                "cs",
                "ro",
                "da",
                "hu",
                "ta",
                "no",
                "th",
                "ur",
                "hr",
                "bg",
                "lt",
                "la",
                "mi",
                "ml",
                "cy",
                "sk",
                "te",
                "fa",
                "lv",
                "bn",
                "sr",
                "az",
                "sl",
                "kn",
                "et",
                "mk",
                "br",
                "eu",
                "is",
                "hy",
                "ne",
                "mn",
                "bs",
                "kk",
                "sq",
                "sw",
                "gl",
                "mr",
                "pa",
                "si",
                "km",
                "sn",
                "yo",
                "so",
                "af",
                "oc",
                "ka",
                "be",
                "tg",
                "sd",
                "gu",
                "am",
                "yi",
                "lo",
                "uz",
                "fo",
                "ht",
                "ps",
                "tk",
                "nn",
                "mt",
                "sa",
                "lb",
                "my",
                "bo",
                "tl",
                "mg",
                "as",
                "tt",
                "haw",
                "ln",
                "ha",
                "ba",
                "jw",
                "su",
                "yue"
              ]
            },
            "voices": {
              "title": "Known voices",
              "type": "array",
              "items": {},
              "default": [],
              "description": "Voice folders or patterns of speakers, so known people are named (see the speakers plugin).",
              "x-ui": {
                "type": "voicePatterns"
              }
            }
          },
          "required": [
            "media"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "actions": {
    "Open": {
      "type": "media.open",
      "inputs": {
        "path": "@triggerBody().media"
      }
    },
    "Sound": {
      "type": "If",
      "runAfter": {
        "Open": [
          "Succeeded"
        ]
      },
      "expression": "@body('Open').hasAudio",
      "actions": {
        "Words": {
          "type": "speech-to-text.transcribe",
          "inputs": {
            "media": "@body('Open')",
            "model": "@triggerBody().model",
            "language": "@triggerBody().language"
          }
        },
        "Who": {
          "type": "speakers.find",
          "inputs": {
            "media": "@body('Open')",
            "voices": "@triggerBody().voices",
            "files": false
          }
        },
        "Tone": {
          "type": "voice-tone.measure",
          "runAfter": {
            "Words": [
              "Succeeded"
            ]
          },
          "inputs": {
            "media": "@body('Open')",
            "segments": "@body('Words').sentences"
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "Picture": {
      "type": "If",
      "runAfter": {
        "Open": [
          "Succeeded"
        ]
      },
      "expression": "@body('Open').hasVideo",
      "actions": {
        "Faces": {
          "type": "face-emotion.find",
          "inputs": {
            "media": "@body('Open')"
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "Tell": {
      "type": "narrator.narrate",
      "runAfter": {
        "Sound": [
          "Succeeded"
        ],
        "Picture": [
          "Succeeded"
        ]
      },
      "inputs": {
        "sentences": "@if(body('Open').hasAudio, body('Words').sentences, createArray())",
        "turns": "@if(body('Open').hasAudio, body('Who').turns, createArray())",
        "tones": "@if(body('Open').hasAudio, body('Tone').segments, createArray())",
        "expressions": "@if(body('Open').hasVideo, body('Faces').expressions, createArray())"
      }
    }
  },
  "outputs": {
    "lines": {
      "type": "array",
      "value": "@body('Tell').lines"
    },
    "text": {
      "type": "string",
      "value": "@body('Tell').text"
    },
    "people": {
      "type": "array",
      "value": "@body('Tell').people"
    }
  }
}
